# =============================================================================
# PRIME ROYAL PREPARATORY SCHOOL (P.R.P.S.) — Environment Reference
# -----------------------------------------------------------------------------
# Copy this file to the appropriate location when bootstrapping a new machine.
#   - Root reference:   .env.example        (this file, documentation only)
#   - Backend config:   backend/.env        (loads DATABASE_URL, PORT, ...)
#   - Frontend config:  frontend/.env       (VITE_API_URL only)
#
# Run `npm run setup` to copy these examples into backend/.env and frontend/.env
# automatically. NEVER commit real secrets.
# =============================================================================

# --- Backend -----------------------------------------------------------------
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173

# PostgreSQL connection string used by Prisma (database package).
# Replace the password placeholder with the real password for the `postgres`
# role in your local PostgreSQL instance (database: primeroyal).
DATABASE_URL=postgresql://postgres:REPLACE_WITH_POSTGRES_PASSWORD@localhost:5432/primeroyal?schema=public

# Used by future phases (Phase 2+). Placeholder value only — never ship a real
# secret in a committed file.
JWT_SECRET=change-me-in-production

# --- Frontend ----------------------------------------------------------------
# Base URL of the PRPS backend API. Exposed to the browser bundle, so it must
# NEVER contain secrets.
VITE_API_URL=http://localhost:4000
