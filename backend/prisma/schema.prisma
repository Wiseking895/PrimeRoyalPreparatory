// Prisma schema for the PRPS School Management System.
//
// PHASE 1 SCOPE — PostgreSQL foundation only.
//
// The full relational model (School, Users, Roles, Permissions, Staff,
// Teachers, Pupils, Parents, Classes, Subjects, Academic Years, Terms,
// Assessments, SBA, Reports, Invoices, Payments, Fees, Attendance, Lesson
// Plans, ...) is intentionally NOT created here. Domain tables are added in
// their owning phases via migrations. Never hand-edit a live database; always
// evolve this schema through Prisma migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Single source of truth for the school's identity. Populated by the seed
/// script with the values from @prps/shared.
model SchoolProfile {
  id           String   @id @default(cuid())
  name         String
  abbreviation String
  motto        String
  tagline      String?
  email        String?
  phone        String?
  address      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("school_profile")
}

// =============================================================================
// PHASE 2 — Owner → Headteacher authority & staff administration (RBAC).
// Users, roles, permissions, role assignments, staff profiles and audit log.
// =============================================================================

enum AccountStatus {
  ACTIVE
  INACTIVE
}

enum Gender {
  MALE
  FEMALE
}

enum PupilStatus {
  ACTIVE
  INACTIVE
}

model Role {
  id              String           @id @default(cuid())
  name            String           @unique
  description     String?
  isSystem        Boolean          @default(false)
  rolePermissions RolePermission[]
  users           UserRole[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@map("roles")
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  label       String
  module      String
  description String?
  isSystem    Boolean          @default(false)
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id                 String        @id @default(cuid())
  fullName           String
  email              String        @unique
  phone              String?
  passwordHash       String
  profilePictureUrl  String?
  status             AccountStatus @default(ACTIVE)
  lastLoginAt        DateTime?
  mustChangePassword Boolean       @default(false)
  roles                UserRole[]
  staffProfile         StaffProfile?
  guardianAccounts     Guardian[]         @relation("GuardianAccountCreator")
  auditLogs            AuditLog[]
  teachingAssignments  TeachingAssignment[] @relation("TeachingAssignmentTeacher")
  classTeachers        ClassTeacher[]       @relation("ClassTeacherTeacher")
  sbaRecords           SbaRecord[]          @relation("SbaRecordTeacher")
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("users")
}

model UserRole {
  userId    String
  roleId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, roleId])
  @@map("user_roles")
}

/// Teaching / non-teaching staff details linked one-to-one to a User.
model StaffProfile {
  id               String   @id @default(cuid())
  staffId          String   @unique
  userId           String   @unique
  category         String?
  position         String?
  address          String?
  dateJoined       DateTime @default(now())
  responsibilities String?
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([category])
  @@index([position])
  @@map("staff_profiles")
}

/// Append-only audit trail for sensitive administrative actions.
model AuditLog {
  id           String   @id @default(cuid())
  actorUserId  String?
  action       String
  resourceType String?
  resourceId   String?
  metadata     Json?
  ip           String?
  actorUser    User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@index([actorUserId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// =============================================================================
// PHASE 4 — Pupil / Student management.
// School-managed classes, shared guardian records and pupil profiles.
// =============================================================================

/// School classes / academic levels. The class structure is school-managed
/// (not hard-coded in the application): default levels are seeded, and the
/// school may rename, extend or deactivate levels. Pupils reference their
/// current class; a future academic-year history table can build on this
/// without rewriting the pupil model.
model SchoolClass {
  id                 String              @id @default(cuid())
  key                String              @unique
  name               String              @unique
  description        String?
  sortOrder          Int                 @default(0)
  status             AccountStatus       @default(ACTIVE)
  pupils             Pupil[]
  teachingAssignments TeachingAssignment[]
  classTeachers      ClassTeacher[]
  sbaRecords         SbaRecord[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([status])
  @@index([sortOrder])
  @@map("classes")
}

/// A parent/guardian. Shared across pupils so a single guardian can be linked
/// to many pupils and a single pupil to many guardians (via PupilGuardian).
///
/// Phase 7 adds optional login credentials to the same row so a guardian can
/// hold a secure Parent Portal account without a separate identity model:
///   - `accountEmail` is the unique login email (distinct from the contact
///     `email`, which may be shared across guardians).
///   - `passwordHash` is null until an account is provisioned by the school.
///   - `status` reflects the account lifecycle; `mustChangePassword` forces the
///     first-login password change exactly like staff accounts.
///   - `createdByUserId` records which staff member provisioned the account.
model Guardian {
  id                 String          @id @default(cuid())
  fullName           String
  phone              String?
  email              String?
  address            String?
  accountEmail       String?         @unique
  passwordHash       String?
  status             AccountStatus   @default(INACTIVE)
  mustChangePassword Boolean         @default(false)
  lastLoginAt        DateTime?
  createdByUserId    String?
  createdBy          User?           @relation("GuardianAccountCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  pupilGuardians     PupilGuardian[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([email])
  @@index([status])
  @@index([createdByUserId])
  @@map("guardians")
}

/// Join table between pupils and guardians carrying the relationship and the
/// primary / emergency-contact flags that are specific to that pupil.
model PupilGuardian {
  pupilId      String
  guardianId   String
  relationship String?
  isPrimary    Boolean  @default(false)
  isEmergency  Boolean  @default(false)
  pupil        Pupil    @relation(fields: [pupilId], references: [id], onDelete: Cascade)
  guardian     Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@id([pupilId, guardianId])
  @@map("pupil_guardians")
}

/// Pupil / student record. Deactivation is preferred over physical deletion so
/// school history is preserved.
model Pupil {
  id                String          @id @default(cuid())
  pupilId           String          @unique
  admissionNumber   String?         @unique
  firstName         String
  middleName        String?
  lastName          String
  dateOfBirth       DateTime
  gender            Gender
  profilePictureUrl String?
  classId           String
  dateAdmitted      DateTime
  status            PupilStatus     @default(ACTIVE)
  address           String?
  class             SchoolClass     @relation(fields: [classId], references: [id])
  guardians         PupilGuardian[]
  feeAssignments    FeeAssignment[]
  payments          Payment[]
  sbaRecords        SbaRecord[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([status])
  @@index([classId])
  @@index([firstName])
  @@index([lastName])
  @@index([dateAdmitted])
  @@index([createdAt])
  @@map("pupils")
}

// =============================================================================
// PHASE 5 — Fees & Finance Management.
// Academic sessions/terms, fee structures, pupil fee assignments, materialized
// charges, payment records and allocations. Money is stored as PostgreSQL
// numeric (Decimal) so GHS amounts never suffer floating-point errors.
//
// Financial records are never physically deleted: charges are cancelled and
// payments are voided, each with an actor and a reason, so the school always
// retains a complete, auditable history.
// =============================================================================

/// How a fee structure is billed. DRIVES charge generation:
///   - TERMLY: one charge per term of the session (amount = fee.amount)
///   - DAILY:  one charge per term, amount = fee.amount × term.schoolDays
///   - OTHER:  one charge for the whole session (amount = fee.amount)
enum FeeType {
  DAILY
  TERMLY
  OTHER
}

/// How money is accepted at the school.
enum PaymentMethod {
  CASH
  BANK_TRANSFER
  MOBILE_MONEY
  CHEQUE
}

/// Lifecycle of a materialized charge. CANCELLED is the only alternative to
/// ACTIVE — charges are reversed, never deleted.
enum ChargeStatus {
  ACTIVE
  CANCELLED
}

/// Lifecycle of a payment record. VOIDED reverses the payment (and its
/// allocations); a voided payment no longer counts toward balances.
enum PaymentRecordStatus {
  ACTIVE
  VOIDED
}

/// An academic session / school year. Only one session is ACTIVE at a time,
/// enforced by the service layer. Terms belong to a session.
model AcademicSession {
  id        String         @id @default(cuid())
  name      String         @unique
  startDate DateTime
  endDate   DateTime
  status    AccountStatus  @default(ACTIVE)
  terms     AcademicTerm[]
  fees      FinanceFee[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([status])
  @@index([startDate])
  @@index([endDate])
  @@map("academic_sessions")
}

/// A term within an academic session. `schoolDays` is the number of scheduled
/// school days in the term (set by the school) and is required before DAILY
/// fees can be billed for the term.
model AcademicTerm {
  id         String          @id @default(cuid())
  sessionId  String
  name       String
  termNumber Int
  startDate  DateTime
  endDate    DateTime
  schoolDays Int             @default(0)
  status     AccountStatus   @default(ACTIVE)
  session    AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  charges    FeeCharge[]
  sbaRecords SbaRecord[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@unique([sessionId, termNumber])
  @@unique([sessionId, name])
  @@index([status])
  @@index([startDate])
  @@map("academic_terms")
}

/// A fee structure defined for an academic session. The feeType determines how
/// charges materialize (see FeeType). Amounts are stored as Decimal (GHS).
model FinanceFee {
  id          String          @id @default(cuid())
  sessionId   String
  name        String
  feeType     FeeType
  amount      Decimal         @db.Decimal(12, 2)
  description String?
  status      AccountStatus   @default(ACTIVE)
  session     AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  assignments FeeAssignment[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([sessionId, name])
  @@index([sessionId, status])
  @@index([feeType])
  @@map("finance_fees")
}

/// A pupil assigned a fee structure. Deactivation is preferred over deletion:
/// it stops future billing and cancels outstanding charges, but keeps history.
model FeeAssignment {
  id        String        @id @default(cuid())
  pupilId   String
  feeId     String
  status    AccountStatus @default(ACTIVE)
  pupil     Pupil         @relation(fields: [pupilId], references: [id], onDelete: Cascade)
  fee       FinanceFee    @relation(fields: [feeId], references: [id], onDelete: Cascade)
  charges   FeeCharge[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([pupilId, feeId])
  @@index([status])
  @@map("fee_assignments")
}

/// A materialized expected amount for one fee assignment, scoped to a term when
/// applicable. This freezes the billed amount at generation time so later edits
/// to the fee structure do not silently rewrite history. Cancelled charges are
/// preserved for audit but excluded from balances.
model FeeCharge {
  id            String              @id @default(cuid())
  assignmentId  String
  termId        String?
  amount        Decimal             @db.Decimal(12, 2)
  status        ChargeStatus        @default(ACTIVE)
  cancelledAt   DateTime?
  cancelledById String?
  cancelReason  String?
  assignment    FeeAssignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  term          AcademicTerm?       @relation(fields: [termId], references: [id], onDelete: SetNull)
  allocations   PaymentAllocation[]
  createdAt     DateTime            @default(now())

  @@unique([assignmentId, termId])
  @@index([assignmentId])
  @@index([termId])
  @@index([status])
  @@map("fee_charges")
}

/// A payment received from a pupil. The paymentReference is generated
/// server-side and serves as the receipt number. Payments are never deleted:
/// they are VOIDED (with actor + reason), which reverses their allocations.
model Payment {
  id               String              @id @default(cuid())
  paymentReference String              @unique
  pupilId          String
  amountPaid       Decimal             @db.Decimal(12, 2)
  paymentMethod    PaymentMethod
  paymentDate      DateTime
  note             String?
  receivedById     String
  status           PaymentRecordStatus @default(ACTIVE)
  voidedAt         DateTime?
  voidedById       String?
  voidReason       String?
  pupil            Pupil               @relation(fields: [pupilId], references: [id], onDelete: Cascade)
  allocations      PaymentAllocation[]
  createdAt        DateTime            @default(now())

  @@index([pupilId])
  @@index([receivedById])
  @@index([status])
  @@index([paymentDate])
  @@map("payments")
}

/// How a payment's amount is allocated across charges. One payment may settle
/// several charges (e.g. a term fee and a transport fee) on a single receipt.
model PaymentAllocation {
  id        String    @id @default(cuid())
  paymentId String
  chargeId  String
  amount    Decimal   @db.Decimal(12, 2)
  payment   Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  charge    FeeCharge @relation(fields: [chargeId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@unique([paymentId, chargeId])
  @@index([chargeId])
  @@map("payment_allocations")
}

// =============================================================================
// PHASE 6 — Teachers, subjects & School-Based Assessment (SBA).
// The academic model is built on the existing staff/user architecture: a
// teacher is an existing staff member (StaffProfile → User) holding a teaching
// position. Subjects form the reusable catalogue; teaching assignments link a
// teacher + subject + class; a class may have one designated class teacher.
//
// SBA records are deliberately NOT linked to a teaching assignment so that
// deactivating or removing an assignment never destroys historical assessment
// data. Records pin the pupil/subject/class/term at entry time, which keeps
// them available for Phase 7 terminal-report aggregation.
// =============================================================================

/// A subject in the school's academic catalogue. Reusable across classes.
/// Deactivation is preferred over deletion so historical records survive.
model Subject {
  id          String              @id @default(cuid())
  code        String              @unique
  name        String              @unique
  description String?
  status      AccountStatus       @default(ACTIVE)
  assignments TeachingAssignment[]
  sbaRecords  SbaRecord[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([status])
  @@map("subjects")
}

/// A teaching assignment: teacher + subject + class. This is the subject
/// teacher model. Deactivation (never deletion) is used to revoke an
/// assignment so the assignment history and any audit trail remain intact.
model TeachingAssignment {
  id        String        @id @default(cuid())
  teacherId String
  subjectId String
  classId   String
  status    AccountStatus @default(ACTIVE)
  teacher   User          @relation("TeachingAssignmentTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  subject   Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  class     SchoolClass   @relation(fields: [classId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([teacherId, subjectId, classId])
  @@index([teacherId])
  @@index([subjectId])
  @@index([classId])
  @@index([status])
  @@map("teaching_assignments")
}

/// The designated class teacher of a class. A class has at most one class
/// teacher (`classId` is unique); changing the class teacher updates the row,
/// and removing one deletes it with an audited trail. No assessment data
/// depends on this record.
model ClassTeacher {
  id         String      @id @default(cuid())
  classId    String      @unique
  teacherId  String
  assignedBy String?
  class      SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher    User        @relation("ClassTeacherTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([teacherId])
  @@index([classId])
  @@map("class_teachers")
}

/// A School-Based Assessment record for one pupil in one subject for one term.
/// One aggregate record per (pupil, subject, class, term) — the natural unit
/// for Phase 7 terminal-report aggregation. Scores are stored as Decimal so
/// fractional marks (e.g. 18.5 / 20) are preserved. Records reference the
/// recording teacher (`teacherId`) for attribution but remain independent of
/// teaching assignments so history survives assignment changes.
model SbaRecord {
  id        String      @id @default(cuid())
  pupilId   String
  subjectId String
  classId   String
  termId    String
  teacherId String
  score     Decimal     @db.Decimal(5, 2)
  maxScore  Decimal     @db.Decimal(5, 2)
  comment   String?
  pupil     Pupil       @relation(fields: [pupilId], references: [id], onDelete: Restrict)
  subject   Subject     @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  class     SchoolClass @relation(fields: [classId], references: [id], onDelete: Restrict)
  term      AcademicTerm @relation(fields: [termId], references: [id], onDelete: Restrict)
  teacher   User        @relation("SbaRecordTeacher", fields: [teacherId], references: [id], onDelete: Restrict)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([pupilId, subjectId, classId, termId])
  @@index([pupilId])
  @@index([subjectId])
  @@index([classId])
  @@index([termId])
  @@index([teacherId])
  @@map("sba_records")
}
