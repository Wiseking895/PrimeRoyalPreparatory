// Prisma schema for the PRPS School Management System.
//
// PHASE 1 SCOPE — PostgreSQL foundation only.
//
// The full relational model (School, Users, Roles, Permissions, Staff,
// Teachers, Pupils, Parents, Classes, Subjects, Academic Years, Terms,
// Assessments, SBA, Reports, Invoices, Payments, Fees, Attendance, Lesson
// Plans, ...) is intentionally NOT created here. Domain tables are added in
// their owning phases via migrations. Never hand-edit a live database; always
// evolve this schema through Prisma migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Single source of truth for the school's identity. Populated by the seed
/// script with the values from @prps/shared.
model SchoolProfile {
  id           String   @id @default(cuid())
  name         String
  abbreviation String
  motto        String
  tagline      String?
  email        String?
  phone        String?
  address      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("school_profile")
}

// =============================================================================
// PHASE 2 — Owner → Headteacher authority & staff administration (RBAC).
// Users, roles, permissions, role assignments, staff profiles and audit log.
// =============================================================================

enum AccountStatus {
  ACTIVE
  INACTIVE
}

enum Gender {
  MALE
  FEMALE
}

enum PupilStatus {
  ACTIVE
  INACTIVE
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  isSystem    Boolean          @default(false)
  rolePermissions RolePermission[]
  users       UserRole[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("roles")
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  label       String
  module      String
  description String?
  isSystem    Boolean          @default(false)
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id                  String         @id @default(cuid())
  fullName            String
  email               String         @unique
  phone               String?
  passwordHash        String
  profilePictureUrl   String?
  status              AccountStatus  @default(ACTIVE)
  lastLoginAt         DateTime?
  mustChangePassword  Boolean        @default(false)
  roles               UserRole[]
  staffProfile      StaffProfile?
  auditLogs         AuditLog[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("users")
}

model UserRole {
  userId    String
  roleId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, roleId])
  @@map("user_roles")
}

/// Teaching / non-teaching staff details linked one-to-one to a User.
model StaffProfile {
  id               String      @id @default(cuid())
  staffId          String      @unique
  userId           String      @unique
  category         String?
  position         String?
  address          String?
  dateJoined       DateTime    @default(now())
  responsibilities String?
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([category])
  @@index([position])
  @@map("staff_profiles")
}

/// Append-only audit trail for sensitive administrative actions.
model AuditLog {
  id           String   @id @default(cuid())
  actorUserId  String?
  action       String
  resourceType String?
  resourceId   String?
  metadata     Json?
  ip           String?
  actorUser    User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@index([actorUserId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// =============================================================================
// PHASE 4 — Pupil / Student management.
// School-managed classes, shared guardian records and pupil profiles.
// =============================================================================

/// School classes / academic levels. The class structure is school-managed
/// (not hard-coded in the application): default levels are seeded, and the
/// school may rename, extend or deactivate levels. Pupils reference their
/// current class; a future academic-year history table can build on this
/// without rewriting the pupil model.
model SchoolClass {
  id          String        @id @default(cuid())
  key         String        @unique
  name        String        @unique
  description String?
  sortOrder   Int           @default(0)
  status      AccountStatus @default(ACTIVE)
  pupils      Pupil[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
  @@index([sortOrder])
  @@map("classes")
}

/// A parent/guardian. Shared across pupils so a single guardian can be linked
/// to many pupils and a single pupil to many guardians (via PupilGuardian).
model Guardian {
  id             String          @id @default(cuid())
  fullName       String
  phone          String?
  email          String?
  address        String?
  pupilGuardians PupilGuardian[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([email])
  @@map("guardians")
}

/// Join table between pupils and guardians carrying the relationship and the
/// primary / emergency-contact flags that are specific to that pupil.
model PupilGuardian {
  pupilId      String
  guardianId   String
  relationship String?
  isPrimary    Boolean  @default(false)
  isEmergency  Boolean  @default(false)
  pupil        Pupil    @relation(fields: [pupilId], references: [id], onDelete: Cascade)
  guardian     Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@id([pupilId, guardianId])
  @@map("pupil_guardians")
}

/// Pupil / student record. Deactivation is preferred over physical deletion so
/// school history is preserved.
model Pupil {
  id                String        @id @default(cuid())
  pupilId           String        @unique
  admissionNumber   String?       @unique
  firstName         String
  middleName        String?
  lastName          String
  dateOfBirth       DateTime
  gender            Gender
  profilePictureUrl String?
  classId           String
  dateAdmitted      DateTime
  status            PupilStatus   @default(ACTIVE)
  address           String?
  class             SchoolClass   @relation(fields: [classId], references: [id])
  guardians         PupilGuardian[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([status])
  @@index([classId])
  @@index([firstName])
  @@index([lastName])
  @@index([dateAdmitted])
  @@index([createdAt])
  @@map("pupils")
}
