# Backend environment. Copy to backend/.env (or run `npm run setup` at root).
# NEVER commit real secrets.
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173
# Replace the password placeholder with the real password for the `postgres`
# role in your local PostgreSQL instance (database: primeroyal).
DATABASE_URL=postgresql://postgres:REPLACE_WITH_POSTGRES_PASSWORD@localhost:5432/primeroyal?schema=public
JWT_SECRET=change-me-in-production

# ---------------------------------------------------------------------------
# Email (Headteacher invitations)
# ---------------------------------------------------------------------------
# EMAIL_ENABLED=true + EMAIL_HOST + credentials sends real mail through the
# configured SMTP provider. With EMAIL_ENABLED unset/false, the app uses a
# development transport that prints the full message (including the temporary
# credential) to the server log instead of delivering real email — so local
# development never sends credentials to a real person by accident.
#
# EMAIL_ENABLED=false
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_SECURE=false            # true for SMTP over SSL (usually port 465)
# EMAIL_USER=no-reply@example.com
# EMAIL_PASSWORD=replace-me     # SMTP password / app password / API key
# EMAIL_FROM=PRPS <no-reply@example.com>

