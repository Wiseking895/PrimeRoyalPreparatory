# Backend environment. Copy to backend/.env (or run `npm run setup` at root).
# NEVER commit real secrets.
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173
# Replace the password placeholder with the real password for the `postgres`
# role in your local PostgreSQL instance (database: primeroyal).
DATABASE_URL=postgresql://postgres:REPLACE_WITH_POSTGRES_PASSWORD@localhost:5432/primeroyal?schema=public
JWT_SECRET=change-me-in-production

# ---------------------------------------------------------------------------
# Google OAuth (first-time Owner sign-up only)
# ---------------------------------------------------------------------------
# Powers the "Continue with Google" button on /setup/owner. It creates the
# school Owner/Proprietress account — it is NOT connected to the Developer
# bootstrap script, and no Google account ever becomes the Developer.
#
# Leave these unset during local development: the button is then hidden and the
# "Continue with Email" path still works exactly as before.
#
# Setup (manual, in your own Google Cloud project):
#   1. APIs & Services -> Credentials -> Create credentials -> OAuth client ID
#      Application type: Web application
#   2. Authorised JavaScript origins (optional, not used by this flow)
#   3. Authorised redirect URIs:
#        <backend-origin>/api/auth/google/callback
#      e.g. http://localhost:4000/api/auth/google/callback
#           https://prime-royal-preparatory.vercel.app/api/auth/google/callback
#   4. Copy the Client ID and Client secret below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: pin the redirect URI explicitly instead of deriving it from the
# request origin. Must match the console entry character for character.
# Local:     GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
# Production (Vercel backend):
#   GOOGLE_REDIRECT_URI=https://prime-royal-preparatory.vercel.app/api/auth/google/callback
#
# These values are BACKEND-ONLY secrets. Never put them in frontend/.env or any
# VITE_* variable, and never commit real credentials.
#GOOGLE_REDIRECT_URI=

# ---------------------------------------------------------------------------
# GPS Staff Attendance Configuration
# ---------------------------------------------------------------------------
# School coordinates (authoritative PRPS reference point):
#   Latitude: 6.76049
#   Longitude: -1.60950
#   (Atimatim, Afigya Kwabre, Ashanti Region, Ghana)
#
#   These coordinates MUST NOT be overridden by the client.
#   The server calculates distance from these coordinates.
#
# Attendance radius in metres (default: 100)
#ATTENDANCE_RADIUS_METERS=100
# Maximum GPS accuracy in metres (default: 50)
#ATTENDANCE_MAX_ACCURACY_METERS=50
# Maximum location age in seconds (default: 120)
#ATTENDANCE_MAX_LOCATION_AGE_SECONDS=120

# ---------------------------------------------------------------------------
# Email (Headteacher invitations)
# ---------------------------------------------------------------------------
# EMAIL_ENABLED=true + EMAIL_HOST + credentials sends real mail through the
# configured SMTP provider. With EMAIL_ENABLED unset/false, the app uses a
# development transport that prints the full message (including the temporary
# credential) to the server log instead of delivering real email — so local
# development never sends credentials to a real person by accident.
#
# EMAIL_ENABLED=false
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_SECURE=false            # true for SMTP over SSL (usually port 465)
# EMAIL_USER=no-reply@example.com
# EMAIL_PASSWORD=replace-me     # SMTP password / app password / API key
# EMAIL_FROM=PRPS <no-reply@example.com>

# ---------------------------------------------------------------------------
# Cloudflare R2 object storage (private bucket for school documents)
# ---------------------------------------------------------------------------
# R2 stores the binary objects (admission-form PDFs, profile pictures and any
# future generated school documents). PostgreSQL keeps all metadata and the
# business relationships; the bucket holds only the bytes.
#
# The bucket MUST stay PRIVATE (no public r2.dev / custom-domain access).
# Browsers receive short-lived presigned URLs issued by the backend after RBAC
# checks — never credentials, never permanent URLs.
#
# Leave these unset during local development: the application still starts and
# every non-storage feature keeps working. Operations that genuinely need R2
# (e.g. uploading a profile picture) then fail with a clear
# "object storage is not configured" error instead of breaking the whole app.
#
# Find the values in the Cloudflare dashboard:
#   R2 -> your bucket -> Settings / API token
#   endpoint format: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional: lifetime of presigned download URLs in seconds (default 300 = 5 min)
#R2_PRESIGN_EXPIRES_IN=300

